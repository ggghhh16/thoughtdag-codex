{
  "name": "thoughtdag-codex",
  "private": true,
  "version": "0.2.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server.mjs",
    "codex:login": "codex login",
    "codex:status": "codex login status",
    "postinstall": "node scripts/patch-codex-sdk.mjs && node scripts/prepare-windows-launcher.mjs",
    "build": "tsc -b && vite build",
    "test": "npm run test:sdk-patch && npm run test:codex && npm run test:context && npm run test:url-safety && npm run test:integrity && npm run test:security",
    "test:sdk-patch": "node --test scripts/codex-sdk-patch.test.mjs scripts/windows-hidden-console-launcher.test.mjs",
    "test:codex": "node --test scripts/codex-adapter.test.mjs scripts/codex-app-server-client.test.mjs scripts/codex-persistent-adapter.test.mjs",
    "test:context": "node --experimental-strip-types --test scripts/context-url.test.mjs scripts/codex-link.test.mjs scripts/desktop-storage-migration.test.mjs scripts/codex-thread-import.test.mjs",
    "test:url-safety": "node --test scripts/safe-remote-url.test.mjs",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs",
    "preview": "vite preview",
    "desktop": "npm run build && npm --prefix desktop start",
    "test:integrity": "node --experimental-strip-types --test scripts/output-integrity.test.mjs",
    "test:security": "node --test scripts/http-security.test.mjs scripts/safe-remote-url.test.mjs && node scripts/test-markdown-marks.mjs",
    "test:textbook": "node --test scripts/textbook.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@openai/codex-sdk": "0.154.0",
    "@tailwindcss/vite": "^4.1.18",
    "@xyflow/react": "^12.10.0",
    "cors": "^2.8.6",
    "defuddle": "^0.19.2",
    "dompurify": "^3.4.13",
    "express": "^5.2.1",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.2.6",
    "katex": "^0.16.28",
    "lucide-react": "^1.23.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.1.18",
    "turndown": "^7.2.4",
    "zustand": "^5.0.11",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "micromark-util-decode-string": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright-core": "^1.61.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  },
  "description": "A local-first editable thought graph powered by the local Codex agent.",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "llm",
    "dag",
    "canvas",
    "react-flow",
    "ai",
    "knowledge-graph",
    "research-tool",
    "codex"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ggghhh16/thoughtdag-codex.git"
  },
  "bugs": {
    "url": "https://github.com/ggghhh16/thoughtdag-codex/issues"
  },
  "homepage": "https://github.com/ggghhh16/thoughtdag-codex#readme"
}
