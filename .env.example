# ThoughtDAG Codex local server
# Copy this file to .env only when you need an override. The normal path is:
#   npm run codex:login
#   npm run server

# Local loopback port used by the browser app.
PORT=3001

# Optional public deployment used when creating read-only #view= share links.
# Without it, links use the current origin (safe for local use, but not
# reachable from another device).
# VITE_PUBLIC_VIEWER_ORIGIN=https://your-viewer.example

# Optional fork-owned desktop release feed. Leave unset to disable checks.
# VITE_DESKTOP_RELEASES_API=https://api.github.com/repos/you/thoughtdag-codex/releases?per_page=1
# VITE_DESKTOP_DOWNLOAD_URL=https://your-site.example/#download

# Optional: use an API key instead of the cached `codex login` session.
# Never commit the real value.
# CODEX_API_KEY=

# Optional: reuse a non-default Codex configuration directory.
# CODEX_HOME=

# Optional: inherit MCP servers from the user's Codex configuration.
# Disabled by default because external MCP tools are outside the read-only
# filesystem sandbox and may have side effects.
# CODEX_ENABLE_MCP=false

# Optional: maximum simultaneous generations (integer 1-8; default 3).
# CODEX_MAX_CONCURRENCY=3

# Optional extra dev origin when using a non-default loopback frontend port.
# Comma-separated exact origins; remote origins are rejected.
# THOUGHTDAG_ALLOWED_ORIGINS=http://localhost:5174

# Optional only for a trusted local proxy using 198.18.0.0/15 fake-IP DNS.
# Weakens destination classification; disabled unless explicitly true.
# THOUGHTDAG_ALLOW_FAKE_IP=false
